--- !u!114 &799121616
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 799121615}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ff5cffa98f379498f8772e34259619da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ModelGaleri
  turntable: {fileID: 1348257354}
  models:
  - {fileID: 362745996}
  - {fileID: 1584460542}
  - {fileID: 794023795}
  - {fileID: 635567731}
  - {fileID: 898618721}
  - {fileID: 1124489877}
  titles:
  - Oyuncak Kasaba
  - Oyuncak Araba
  - "Kakao Kupas\u0131"
  - "Karton Fig\xFCr"
  - "Ah\u015Fap Manken Eli"
  - El Sallayan El
  details:
  - "<b>Dosya:</b> Mahalle.blend\nEvler, apartmanlar, a\u011Fa\xE7lar, sokak lambalar\u0131
    ve yollar; pencere, kap\u0131, \xE7at\u0131 ve \u0131\u015F\u0131k detaylar\u0131yla
    geli\u015Ftirildi.\n<b>Oyunda:</b> Kul\xFCb\xFCn g\xFCneyinde, yolun ucunda;
    bozuk arabalar\u0131 kald\u0131r\u0131ld\u0131, sokaklar\u0131na oyuncak arabalar
    kondu."
  - "<b>Dosya:</b> Ba\u015Fl\u0131ks\u0131z.blend\nKurma anahtarl\u0131 oyuncak araba;
    farlar, stop lambalar\u0131, jantlar, tampon ve cam detaylar\u0131 eklendi.\n<b>Oyunda:</b>
    Kul\xFCb\xFCn otopark\u0131nda, kasaban\u0131n sokaklar\u0131nda ve ana men\xFCdeki
    adada."
  - "<b>Dosya:</b> untitled.blend\nMarshmallowlu kakao kupas\u0131 ve kurabiye taba\u011F\u0131;
    parlak s\u0131r ve kalp deseni eklendi.\n<b>Oyunda:</b> Kul\xFCp teras\u0131ndaki
    masan\u0131n \xFCst\xFCnde (buhar\u0131 t\xFCter) ve ana men\xFCdeki masada."
  - "<b>Dosya:</b> Kemik.blend\nArkas\u0131 destekli karton insan fig\xFCr\xFC; boyal\u0131
    b\xF6lgeler, y\xFCz ve destek aya\u011F\u0131 eklendi.\n<b>Oyunda:</b> Saha ipinin
    arkas\u0131nda hareketsiz seyirci panolar\u0131 ve kasaban\u0131n kald\u0131r\u0131mlar\u0131nda."
  - "<b>Dosya:</b> Hand2.blend\nEklemli ah\u015Fap manken eli; ah\u015Fap materyaller
    ve parmaklar\u0131n k\u0131vr\u0131ld\u0131\u011F\u0131 animasyonuyla.\n<b>Oyunda:</b>
    Pro Shop vitrininin \xF6n\xFCnde kaide \xFCzerinde ve ana men\xFCdeki adada."
  - "<b>Dosya:</b> EL.blend\nOyuncak bebek teninde, yumu\u015Fat\u0131lm\u0131\u015F
    ve el sallayan animasyonlu el.\n<b>Oyunda:</b> Giri\u015F kap\u0131s\u0131nda
    kar\u015F\u0131lama heykeli ve ana men\xFCn\xFCn arka plan\u0131nda."
  titleText: {fileID: 905393354}
  detailText: {fileID: 382101269}
  counterText: {fileID: 1100716653}
  galleryUI: {fileID: 686897309}
  menuUI: {fileID: 530446751}
